  "ssml": "<speak>Perturbación mecánica que transporta energía mediante variaciones de presión y desplazamientos locales de las partículas de un medio material.<break time=\"0.9s\"/>En una onda longitudinal, las partículas oscilan alrededor de su posición mientras avanzan compresiones y rarefacciones.<break time=\"0.9s\"/>No interpretes las partículas como sangre transportada desde el transductor; aquí representan el medio acústico.<break time=\"1.2s\"/></speak>",
  "cues": [
    {
      "start": 0,
      "end": 8.38,
      "text": "Perturbación mecánica que transporta energía mediante variaciones de presión y desplazamientos locales de las partículas de un medio material."
    },
    {
      "start": 8.38,
      "end": 16.400000000000002,
      "text": "En una onda longitudinal, las partículas oscilan alrededor de su posición mientras avanzan compresiones y rarefacciones."
    },
    {
      "start": 16.400000000000002,
      "end": 24.528969,
      "text": "No interpretes las partículas como sangre transportada desde el transductor; aquí representan el medio acústico."
    }
  ],
  "captions": [
    {
      "start": 0.299,
      "end": 3.797,
      "text": "Perturbación mecánica que transporta energía mediante variaciones de"
    },
    {
      "start": 3.84,
      "end": 7.48,
      "text": "presión y desplazamientos locales de las partículas de un medio material."
    },
    {
      "start": 8.38,
      "end": 12.775,
      "text": "En una onda longitudinal, las partículas oscilan alrededor de su posición"
    },
    {
      "start": 12.86,
      "end": 15.672,
      "text": "mientras avanzan compresiones y rarefacciones."
    },
    {
      "start": 16.400000000000002,
      "end": 19.686,
      "text": "No interpretes las partículas como sangre transportada desde el"
    },
    {
      "start": 19.728,
      "end": 23.094877551020407,
      "text": "transductor; aquí representan el medio acústico."
    }
  ],
