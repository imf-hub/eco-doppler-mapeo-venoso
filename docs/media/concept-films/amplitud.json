  "ssml": "<speak>Magnitud máxima de una oscilación respecto de su valor de equilibrio; puede describir presión acústica o amplitud de una señal recibida.<break time=\"0.9s\"/>Cambiar amplitud modifica la excursión de la onda, no necesariamente sus ciclos.<break time=\"0.9s\"/>Una onda más alta no significa más ciclos ni mayor velocidad de propagación.<break time=\"1.2s\"/></speak>",
  "cues": [
    {
      "start": 0,
      "end": 8.603,
      "text": "Magnitud máxima de una oscilación respecto de su valor de equilibrio; puede describir presión acústica o amplitud de una señal recibida."
    },
    {
      "start": 8.603,
      "end": 13.817,
      "text": "Cambiar amplitud modifica la excursión de la onda, no necesariamente sus ciclos."
    },
    {
      "start": 13.817,
      "end": 19.513469,
      "text": "Una onda más alta no significa más ciclos ni mayor velocidad de propagación."
    }
  ],
  "captions": [
    {
      "start": 0.299,
      "end": 3.84,
      "text": "Magnitud máxima de una oscilación respecto de su valor de equilibrio;"
    },
