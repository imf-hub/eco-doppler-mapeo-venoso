  "ssml": "<speak>Propiedad del medio definida como densidad por velocidad acústica; la diferencia entre impedancias influye en la reflexión en una interfaz.<break time=\"0.9s\"/>A incidencia normal y en el modelo de medios ideales, la fracción de intensidad reflejada depende de ((Z₂−Z₁)/(Z₂+Z₁))².<break time=\"0.9s\"/>La reflexión depende también de la geometría; esta relación ideal no caracteriza por sí sola una lesión.<break time=\"1.2s\"/></speak>",
  "cues": [
    {
      "start": 0,
      "end": 9.225,
      "text": "Propiedad del medio definida como densidad por velocidad acústica; la diferencia entre impedancias influye en la reflexión en una interfaz."
    },
    {
      "start": 9.225,
      "end": 20.256,
      "text": "A incidencia normal y en el modelo de medios ideales, la fracción de intensidad reflejada depende de ((Z₂−Z₁)/(Z₂+Z₁))²."
    },
    {
      "start": 20.256,
      "end": 28.395094,
      "text": "La reflexión depende también de la geometría; esta relación ideal no caracteriza por sí sola una lesión."
    }
  ],
  "captions": [
    {
      "start": 0.299,
      "end": 4.9067,
      "text": "Propiedad del medio definida como densidad por velocidad acústica; la"
    },
    {
      "start": 4.949,
      "end": 8.325,
      "text": "diferencia entre impedancias influye en la reflexión en una interfaz."
    },
    {
      "start": 9.225,
      "end": 13.449,
      "text": "A incidencia normal y en el modelo de medios ideales, la fracción de"
    },
    {
      "start": 13.491999999999999,
      "end": 19.355999999999998,
      "text": "intensidad reflejada depende de ((Z₂−Z₁)/(Z₂+Z₁))²."
    },
    {
      "start": 20.256,
      "end": 24.906,
      "text": "La reflexión depende también de la geometría; esta relación ideal no"
    },
    {
      "start": 24.949,
      "end": 26.95450566893424,
      "text": "caracteriza por sí sola una lesión."
    }
  ],
